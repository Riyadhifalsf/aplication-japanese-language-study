# Backend Japanese Study — environment
# Copy ke .env dan isi nilai acak untuk produksi.
POSTGRES_PASSWORD=ganti-dengan-password-panjang-acak
JWT_SECRET=ganti-dengan-jwt-secret-panjang-acak
ADMIN_TOKEN=ganti-dengan-token-admin-panjang-acak
ADMIN_EMAIL=admin@domainmu.com
ADMIN_PASSWORD=ganti-password-admin-panjang
TLS_IP=192.168.100.11
CORS_ORIGIN=*
# Project ID Firebase (Console → Project settings) untuk cek `aud` ID token.
# Kosongkan = aud tidak dicek (tetap verifikasi signature + exp + iss).
FIREBASE_PROJECT_ID=
