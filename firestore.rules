rules_version = '2';

// Japanese Study — user hanya boleh baca/tulis progress miliknya sendiri.
// UID dokumen HARUS sama dengan Firebase Auth UID (lihat cloudUid di app).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/progress/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
